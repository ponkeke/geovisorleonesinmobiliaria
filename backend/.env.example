PORT=4000
DATABASE_URL=postgres://leones:leones@localhost:5433/geovisor
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=8h

PRECIO_M2_REFERENCIA=170
DATABASE_URL_TEST=postgres://leones:leones@localhost:5433/geovisor_test

# Lugares cercanos (Overpass API, consultada desde el servidor)
OVERPASS_URL=https://overpass.openstreetmap.fr/api/interpreter
OVERPASS_RADIO_M=500
OVERPASS_TIMEOUT_MS=30000
OVERPASS_REINTENTOS=2
# Espejo si el servidor principal falla (opcional) y User-Agent enviado a Overpass
OVERPASS_URL_ALT=https://overpass-api.de/api/interpreter
OVERPASS_USER_AGENT=GeovisorLeones/1.0 (proyecto de tesis, Universidad Continental)

# Validación de polígonos (R1-R4)
MIN_AREA_M2=30
MIN_ANCHO_M=3
COMPACIDAD_MIN=0.1
COLINEAL_EPSILON_GRADOS2=1e-14
VIA_SUPERPOSICION_MAX_PCT=10
# Se tolera solo un roce de borde (imprecisión al dibujar junto a un terreno colindante)
TRASLAPE_MAX_PCT=1
VALIDAR_VIAS=true
# Ancho total de la franja de cada tipo de vía, en metros (se ignoran footway, path, steps...)
VIAS_ANCHOS_M=primary:12,secondary:10,tertiary:8,residential:6,unclassified:5,service:4
VIAS_DIAS_CACHE=30
VIAS_MARGEN_M=100
# Tope (ms) de la consulta de vías a Overpass al validar; si no responde, se valida sin la regla R3 y se avisa
VIAS_TIMEOUT_MS=30000
# Endpoint público POST /api/poligonos/validar: tamaño máximo (bytes), vértices y rate limit por IP
VALIDAR_MAX_BYTES=51200
VALIDAR_MAX_VERTICES=500
VALIDAR_RATE_MAX=30
VALIDAR_RATE_VENTANA_MS=60000

# Fotos de visita y reportes técnicos: carpeta de almacenamiento (por defecto backend/uploads), tamaños máximos y tope por terreno
# UPLOADS_DIR=
FOTO_MAX_MB=10
REPORTE_MAX_MB=15
ARCHIVOS_MAX_POR_TERRENO=40
